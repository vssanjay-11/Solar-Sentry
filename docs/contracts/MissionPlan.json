{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MissionPlan",
  "description": "Structured mission execution plan generated by Agent 9 (Mission Planner & Active Perception).",
  "type": "object",
  "properties": {
    "mission_id": {
      "type": "string",
      "description": "Unique identifier for the mission"
    },
    "name": {
      "type": "string",
      "description": "Descriptive mission title"
    },
    "mission_type": {
      "type": "string",
      "enum": ["OBSERVE", "SCAN", "WAIT", "SUSPEND", "SAFE", "ACTIVE_PERCEPTION", "CALIBRATE"],
      "description": "Core mission type"
    },
    "priority": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "description": "Mission priority (higher values preempt lower values; 100=Emergency/Safety)"
    },
    "objective": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "target_quality_min": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "max_uncertainty": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "target_region": { "type": "string" },
        "active_perception_required": { "type": "boolean" }
      },
      "required": ["name"]
    },
    "status": {
      "type": "string",
      "enum": ["PENDING", "PLANNING", "EXECUTING", "VERIFYING", "COMPLETED", "FAILED", "ABORTED", "SUSPENDED"],
      "description": "Current execution lifecycle state"
    },
    "candidates": {
      "type": "array",
      "description": "Evaluated candidate regions or directions",
      "items": {
        "type": "object",
        "properties": {
          "region_id": { "type": "string" },
          "pan": { "type": "integer", "minimum": 0, "maximum": 180 },
          "tilt": { "type": "integer", "minimum": 0, "maximum": 180 },
          "predicted_quality": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "uncertainty": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "composite_score": { "type": "number" }
        },
        "required": ["region_id", "pan", "tilt", "predicted_quality"]
      }
    },
    "selected_candidate": {
      "type": ["object", "null"],
      "description": "Candidate selected by planner"
    },
    "actions": {
      "type": "array",
      "description": "Sequenced mission actions to execute",
      "items": {
        "type": "object",
        "properties": {
          "action_id": { "type": "string" },
          "action_type": { "type": "string" },
          "command": { "$ref": "Command.json#" },
          "timeout_sec": { "type": "number", "minimum": 0.1 },
          "status": { "type": "string" }
        },
        "required": ["action_id", "action_type", "command"]
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "timeout_sec": {
      "type": "number",
      "minimum": 1.0
    }
  },
  "required": [
    "mission_id",
    "mission_type",
    "priority",
    "objective",
    "status",
    "actions",
    "created_at"
  ]
}
