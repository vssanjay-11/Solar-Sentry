{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ObservationQualityPrediction",
  "description": "Structured output schema generated by Agent 6 (Environment Intelligence) for consumption by Agent 8 (Cognitive Decision Engine).",
  "type": "object",
  "properties": {
    "current_quality": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Current composite observation quality score (0.0=unusable, 1.0=ideal)",
      "example": 0.86
    },
    "predictions": {
      "type": "object",
      "properties": {
        "15m": { "type": "number", "minimum": 0.0, "maximum": 1.0, "example": 0.82 },
        "30m": { "type": "number", "minimum": 0.0, "maximum": 1.0, "example": 0.74 },
        "60m": { "type": "number", "minimum": 0.0, "maximum": 1.0, "example": 0.51 }
      },
      "required": ["15m", "30m", "60m"],
      "description": "Predicted observation quality scores across time horizons"
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Prediction confidence based on sensor health, trend stability, and model variance",
      "example": 0.88
    },
    "risk": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"],
      "description": "Overall environmental threat level",
      "example": "MEDIUM"
    },
    "risk_factors": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "RAIN_DETECTED",
          "PRECIPITATION_IMMINENT",
          "CONDENSATION_RISK",
          "HIGH_HUMIDITY",
          "RAPID_CLOUD_DEVELOPMENT",
          "ATMOSPHERIC_TURBULENCE",
          "LOW_SOLAR_ALTITUDE",
          "NIGHT_TIME",
          "SENSOR_DEGRADED"
        ]
      },
      "description": "List of active environmental hazards detected"
    },
    "trend": {
      "type": "object",
      "properties": {
        "lux_trend": { "type": "string", "enum": ["RISING", "FALLING", "STEADY", "VOLATILE"] },
        "pressure_trend": { "type": "string", "enum": ["RISING", "FALLING", "STEADY", "VOLATILE"] },
        "humidity_trend": { "type": "string", "enum": ["RISING", "FALLING", "STEADY", "VOLATILE"] },
        "temperature_trend": { "type": "string", "enum": ["RISING", "FALLING", "STEADY", "VOLATILE"] }
      },
      "required": ["lux_trend", "pressure_trend", "humidity_trend", "temperature_trend"]
    },
    "model_version": {
      "type": "string",
      "description": "Semantic model version identifier",
      "example": "1.0.0-physics-baseline"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 UTC timestamp of prediction calculation"
    }
  },
  "required": [
    "current_quality",
    "predictions",
    "confidence",
    "risk",
    "model_version"
  ]
}
