# ===============================================================
# Solar Sentry — Environment Configuration
# ===============================================================

# System Environment
ENVIRONMENT=development
DEBUG=True

# Backend Server Binding & URLs
HOST=0.0.0.0
PORT=8000
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Database Connection
# SQLite for local development; PostgreSQL for production
SOLAR_SENTRY_DB_URL=sqlite:///solarsentry.db
SOLAR_SENTRY_DB_ECHO=false

# System Operating Mode (DEMO or HARDWARE)
# DEMO: Autonomous simulation with synthetic sensors and camera
# HARDWARE: Live physical binding to ESP32 DevKit and ESP32-CAM
SOLAR_SENTRY_DEFAULT_MODE=DEMO
DEFAULT_DEVICE_ID=esp32-sentry-01

# Dynamic ESP32-CAM Auto-Discovery & Camera Registry
# The ESP32-CAM dynamic IP does NOT need to be manually entered.
# The backend dynamically resolves 'solar-sentry-cam.local' via mDNS across DHCP changes.
CAMERA_DEVICE_ID=SOLAR-SENTRY-CAM-01
CAMERA_MDNS_HOST=solar-sentry-cam.local
CAMERA_PORT=80
# Optional manual fallback if mDNS multicast is blocked on local network:
ESP32_CAM_URL=http://192.168.1.120

# Physical ESP32 Controller IP (Optional direct edge endpoint)
ESP32_EDGE_IP=http://192.168.1.121

# Security & API Authentication
REQUIRE_API_KEY=False
API_KEY=solar-sentry-dev-key-2026
EDGE_API_KEY=solar-sentry-edge-key-2026

# Heartbeat and Watchdog Timeouts (Seconds)
DEVICE_HEARTBEAT_TIMEOUT_SEC=30

# Image Frame Storage Path
IMAGE_STORAGE_PATH=data/images
