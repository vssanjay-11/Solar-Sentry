# ===============================================================
# Solar Sentry — Environment Configuration
# ===============================================================

# System Environment (development / staging / production)
ENVIRONMENT=development
DEBUG=True

# Backend Server Binding
HOST=0.0.0.0
PORT=8000

# Database Connection
# Defaults to SQLite for local development; PostgreSQL for production
# Example PostgreSQL: postgresql://postgres:postgres@localhost:5432/solarsentry
SOLAR_SENTRY_DB_URL=sqlite:///solarsentry.db
SOLAR_SENTRY_DB_ECHO=false

# Hardware Integration & ESP32 Configuration
# Initial active mode on startup: DEMO or HARDWARE
SOLAR_SENTRY_DEFAULT_MODE=DEMO
DEFAULT_DEVICE_ID=esp32-sentry-01

# ESP32-CAM Target URL (Accessible over local WiFi/Ethernet)
ESP32_CAM_URL=http://192.168.1.120

# Physical ESP32 Controller IP (Optional direct edge endpoint)
ESP32_EDGE_IP=http://192.168.1.121

# Security & API Authentication
REQUIRE_API_KEY=False
API_KEY=solar-sentry-dev-key-2026
EDGE_API_KEY=solar-sentry-edge-key-2026

# Heartbeat and Watchdog Timeouts (Seconds)
DEVICE_HEARTBEAT_TIMEOUT_SEC=30

# Image Frame Storage Path
IMAGE_STORAGE_PATH=data/images
